# ─────────────────────────────────────────────────
#  VibeLink Environment Variables
#  Copy this file to .env.local for local dev,
#  or set these in cPanel → Node.js → Environment Variables
# ─────────────────────────────────────────────────

# ── Application ──────────────────────────────────
NODE_ENV=production
PORT=3000

# The public URL of your site (no trailing slash)
# Local:      http://localhost:3000
# Production: https://yourdomain.com
CLIENT_URL=https://yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com

# ── MySQL Database ────────────────────────────────
# cPanel: use the credentials from MySQL Databases
# Local:  use your local MySQL server
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanelusername_vibelink
DB_USER=cpanelusername_vbuser
DB_PASSWORD=your_db_password_here

# ── Admin dashboard ───────────────────────────────
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_TOKEN=change_this_random_secret_token

# ── Metered TURN (server-side only — never prefix with NEXT_PUBLIC_) ──────
# Get from: https://dashboard.metered.ca → Your App → API Key
METERED_DOMAIN=yourapp.metered.live
METERED_API_KEY=your_metered_api_key_here
